{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wiki",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "tools/serve_wiki.py",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8010",
        "--directory",
        "site"
      ],
      "port": 8010
    }
  ]
}
